function getErrorMessage(
  data: unknown,
  fallback: string
) {
  if (
    data &&
    typeof data === "object"
  ) {
    const object =
      data as Record<string, unknown>;

    if (
      typeof object.message === "string"
    ) {
      return object.message;
    }

    if (
      typeof object.error === "string"
    ) {
      return object.error;
    }
  }

  return fallback;
}

function formatExpiry(value: string) {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Expires soon";
  }

  return `Expires at ${date.toLocaleTimeString(
    [],
    {
      hour: "2-digit",
      minute: "2-digit",
    }
  )}`;
}

export default function ClaimPage() {
  const [screen, setScreen] =
    useState<Screen>("loading");

  const [viewer, setViewer] =
    useState<Viewer | null>(null);

  const [claims, setClaims] =
    useState<PendingClaim[]>([]);

  const [
    processingClaimId,
    setProcessingClaimId,
  ] = useState<string | null>(null);

  const [discount, setDiscount] =
    useState<Discount | null>(null);

  const [
    claimedStreamerName,
    setClaimedStreamerName,
  ] = useState("");

  const [errorMessage, setErrorMessage] =
    useState("");

  const [copied, setCopied] =
    useState(false);

  const twitchLoginUrl =
    `${API_URL}/api/auth/viewer/twitch/login`;

  const loadPendingClaims =
    useCallback(async () => {
      setScreen("loading");
      setErrorMessage("");
      setProcessingClaimId(null);

      try {
        const response = await fetch(
          `${API_URL}/api/claims/pending`,
          {
            method: "GET",
            credentials: "include",
            cache: "no-store",
            headers: {
              Accept: "application/json",
            },
          }
        );

        const data =
          await response
            .json()
            .catch(() => null);

        if (response.status === 401) {
          setViewer(null);
          setClaims([]);
          setScreen("anonymous");
          return;
        }

        if (response.status === 404) {
          setClaims([]);
          setErrorMessage(
            getErrorMessage(
              data,
              "No active discount claim was found for this Twitch account."
            )
          );
          setScreen("no_claim");
          return;
        }

        if (
          !response.ok ||
          !data?.ok
        ) {
          throw new Error(
            getErrorMessage(
              data,
              "Unable to check your pending discounts."
            )
          );
        }

        const receivedClaims: PendingClaim[] =
          Array.isArray(data.claims)
            ? data.claims
            : data.claim
              ? [data.claim]
              : [];

        if (!receivedClaims.length) {
          setClaims([]);
          setScreen("no_claim");
          return;
        }

        setClaims(receivedClaims);
        setScreen("ready");
      } catch (error) {
        setErrorMessage(
          error instanceof Error
            ? error.message
            : "Unable to check your pending discounts."
        );

        setScreen("error");
      }
    }, []);

  useEffect(() => {
    async function start() {
      try {
        const response = await fetch(
          `${API_URL}/api/auth/viewer/me`,
          {
            method: "GET",
            credentials: "include",
            cache: "no-store",
            headers: {
              Accept: "application/json",
            },
          }
        );

        if (response.status === 401) {
          setScreen("anonymous");
          return;
        }

        const data =
          await response.json();

        if (
          !response.ok ||
          data?.authenticated !== true ||
          !data?.viewer
        ) {
          throw new Error(
            "Unable to verify your Twitch session."
          );
        }

        setViewer(data.viewer);

        await loadPendingClaims();
      } catch (error) {
        setErrorMessage(
          error instanceof Error
            ? error.message
            : "Unable to verify your Twitch session."
        );

        setScreen("error");
      }
    }

    void start();
  }, [loadPendingClaims]);

  async function redeemDiscount(
    claim: PendingClaim
  ) {
    setProcessingClaimId(claim.id);
    setErrorMessage("");

    try {
      const response = await fetch(
        `${API_URL}/api/claims/redeem`,
        {
          method: "POST",
          credentials: "include",
          headers: {
            Accept: "application/json",
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify({
            claimId: claim.id,
          }),
        }
      );

      const data =
        await response
          .json()
          .catch(() => null);

      if (
        !response.ok ||
        !data?.ok ||
        !data?.discount
      ) {
        throw new Error(
          getErrorMessage(
            data,
            "Unable to generate your discount."
          )
        );
      }

      setDiscount(data.discount);

      setClaimedStreamerName(
        data.streamer?.displayName ||
        data.streamer?.twitchLogin ||
        claim.streamer.displayName
      );

      setClaims((currentClaims) =>
        currentClaims.filter(
          (currentClaim) =>
            currentClaim.id !== claim.id
        )
      );

      setProcessingClaimId(null);
      setScreen("success");
    } catch (error) {
      setProcessingClaimId(null);

      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Unable to generate your discount."
      );

      setScreen("ready");
    }
  }

  async function switchAccount() {
    try {
      await fetch(
        `${API_URL}/api/auth/viewer/logout`,
        {
          method: "POST",
          credentials: "include",
          headers: {
            "Content-Type":
              "application/json",
          },
          body: JSON.stringify({}),
        }
      );
    } finally {
      window.location.assign(
        twitchLoginUrl
      );
    }
  }

  async function copyCode() {
    if (!discount?.code) {
      return;
    }

    await navigator.clipboard.writeText(
      discount.code
    );

    setCopied(true);

    window.setTimeout(() => {
      setCopied(false);
    }, 2000);
  }

  const viewerName =
    viewer?.displayName ||
    viewer?.login;

  return (
    <main style={styles.page}>
      <section style={styles.card}>
        <div style={styles.logo}>
          Dropify
          <span style={styles.purple}>
            Bot
          </span>
        </div>

        {screen === "success" ? (
          <div style={styles.successBadge}>
            Discount ready
          </div>
        ) : (
          <div style={styles.badge}>
            Private discount
          </div>
        )}

        {screen === "loading" && (
          <>
            <h1 style={styles.heading}>
              Checking your discounts
            </h1>

            <p style={styles.description}>
              DropifyBot is looking for
              pending claims connected to your
              Twitch account.
            </p>

            <button
              type="button"
              disabled
              style={styles.disabledButton}
            >
              Checking…
            </button>
          </>
        )}

        {screen === "anonymous" && (
          <>
            <h1 style={styles.heading}>
              Claim your discount
            </h1>

            <p style={styles.description}>
              Sign in with Twitch so
              DropifyBot can confirm which
              discounts belong to you.
            </p>

            <a
              href={twitchLoginUrl}
              style={styles.primaryButton}
            >
              Continue with Twitch
            </a>

            <p style={styles.note}>
              DropifyBot never receives your
              Twitch password.
            </p>
          </>
        )}

        {screen === "ready" &&
          viewer && (
            <>
              <h1 style={styles.heading}>
                {claims.length > 1
                  ? "Choose your discount"
                  : "Your discount is ready"}
              </h1>

              <p style={styles.description}>
                {claims.length > 1
                  ? "You have pending discounts from multiple streamers. Choose which one you want to claim."
                  : "We found a private discount connected to your Twitch account."}
              </p>

              <div style={styles.viewerBox}>
                <p style={styles.boxLabel}>
                  Signed in as
                </p>

                <p style={styles.boxValue}>
                  @{viewerName}
                </p>
              </div>

              {errorMessage && (
                <div style={styles.errorBox}>
                  {errorMessage}
                </div>
              )}

              <div style={styles.claimList}>
                {claims.map((claim) => {
                  const isProcessing =
                    processingClaimId ===
                    claim.id;

                  const unavailable =
                    claim.status ===
                    "processing";

                  return (
                    <div
                      key={claim.id}
                      style={styles.claimCard}
                    >
                      <div
                        style={
                          styles.claimHeader
                        }
                      >
                        <p
                          style={
                            styles.streamerName
                          }
                        >
                          {
                            claim.streamer
                              .displayName
                          }
                        </p>

                        <span
                          style={
                            unavailable
                              ? styles.statusProcessing
                              : styles.statusPending
                          }
                        >
                          {unavailable
                            ? "Processing"
                            : "Ready"}
                        </span>
                      </div>

                      <p
                        style={
                          styles.streamerLogin
                        }
                      >
                        @
                        {
                          claim.streamer
                            .twitchLogin
                        }
                      </p>

                      <p style={styles.expiry}>
                        {formatExpiry(
                          claim.expiresAt
                        )}
                      </p>

                      <button
                        type="button"
                        disabled={
                          isProcessing ||
                          unavailable
                        }
                        style={
                          isProcessing ||
                          unavailable
                            ? styles.disabledButton
                            : styles.smallPrimaryButton
                        }
                        onClick={() =>
                          redeemDiscount(
                            claim
                          )
                        }
                      >
                        {isProcessing
                          ? "Creating discount…"
                          : unavailable
                            ? "Already processing"
                            : `Claim from ${claim.streamer.displayName}`}
                      </button>
                    </div>
                  );
                })}
              </div>

              <button
                type="button"
                style={styles.secondaryButton}
                onClick={
                  loadPendingClaims
                }
              >
                Refresh discounts
              </button>

              <button
                type="button"
                style={styles.secondaryButton}
                onClick={switchAccount}
              >
                Switch Twitch account
              </button>
            </>
          )}

        {screen === "no_claim" &&
          viewer && (
            <>
              <h1 style={styles.heading}>
                No pending discount
              </h1>

              <div style={styles.viewerBox}>
                <p style={styles.boxLabel}>
                  Signed in as
                </p>

                <p style={styles.boxValue}>
                  @{viewerName}
                </p>
              </div>

              {errorMessage && (
                <div style={styles.errorBox}>
                  {errorMessage}
                </div>
              )}

              <p style={styles.description}>
                Type{" "}
                <strong>!discount</strong>{" "}
                in a supported streamer&apos;s
                Twitch chat using this same
                account, then check again.
              </p>

              <button
                type="button"
                style={styles.primaryButton}
                onClick={
                  loadPendingClaims
                }
              >
                Check again
              </button>

              <button
                type="button"
                style={styles.secondaryButton}
                onClick={switchAccount}
              >
                Switch Twitch account
              </button>
            </>
          )}

        {screen === "success" &&
          discount && (
            <>
              <h1 style={styles.heading}>
                Discount claimed
              </h1>

              <p style={styles.description}>
                Your private discount from{" "}
                <strong>
                  {claimedStreamerName}
                </strong>{" "}
                was created successfully.
              </p>

              <div style={styles.codeBox}>
                <p style={styles.boxLabel}>
                  Your discount code
                </p>

                <p style={styles.code}>
                  {discount.code}
                </p>
              </div>

              <button
                type="button"
                style={styles.primaryButton}
                onClick={copyCode}
              >
                {copied
                  ? "Copied!"
                  : "Copy discount code"}
              </button>

              <p style={styles.note}>
                This code is valid for about
                ten minutes. Do not share it.
              </p>

              {claims.length > 0 && (
                <button
                  type="button"
                  style={
                    styles.secondaryButton
                  }
                  onClick={
                    loadPendingClaims
                  }
                >
                  View remaining discounts
                </button>
              )}
            </>
          )}

        {screen === "error" && (
          <>
            <h1 style={styles.heading}>
              Something went wrong
            </h1>

            <div style={styles.errorBox}>
              {errorMessage ||
                "DropifyBot could not complete your request."}
            </div>

            <button
              type="button"
              style={styles.primaryButton}
              onClick={
                loadPendingClaims
              }
            >
              Try again
            </button>

            <button
              type="button"
              style={styles.secondaryButton}
              onClick={switchAccount}
            >
              Switch Twitch account
            </button>
          </>
        )}

        <a
          href="/"
          style={styles.footerLink}
        >
          Return to DropifyBot
        </a>
      </section>
    </main>
  );
}
