import {
  useCallback,
  useEffect,
  useState,
  type CSSProperties,
} from "react";

const API_URL =
  process.env.NEXT_PUBLIC_API_URL ||
  "https://api.dropifybot.com";

type Viewer = {
  twitchId: string;
  login: string;
  displayName?: string;
  profileImageUrl?: string | null;
};

type PendingClaim = {
  id: string;
  status: "pending" | "processing";
  viewerLogin: string;
  viewerDisplayName?: string;
  expiresAt: string;
  streamer: {
    twitchLogin: string;
    displayName: string;
  };
};

type Discount = {
  code: string;
  type?: string;
  value?: number;
  expiresAt: string;
};

type Screen =
  | "loading"
  | "anonymous"
  | "ready"
  | "no_claim"
  | "success"
  | "error";

