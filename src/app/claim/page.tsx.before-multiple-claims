    padding: "24px",
    background:
      "radial-gradient(circle at top, #25134d 0%, #10091f 42%, #07050d 100%)",
    color: "#ffffff",
    fontFamily: "Arial, Helvetica, sans-serif",
  },

  card: {
    width: "100%",
    maxWidth: "520px",
    padding: "40px",
